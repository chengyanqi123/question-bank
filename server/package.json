{
  "name": "question-bank-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "migrate": "pnpm build && node dist/migrate.js",
    "migrate:prod": "node dist/migrate.js",
    "backup:prod": "node dist/backup.js"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
